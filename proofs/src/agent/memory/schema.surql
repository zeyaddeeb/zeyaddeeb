DEFINE ANALYZER IF NOT EXISTS prose TOKENIZERS blank, class, punct FILTERS lowercase, ascii, snowball(english);
DEFINE TABLE IF NOT EXISTS node SCHEMALESS;
DEFINE INDEX IF NOT EXISTS node_text ON node FIELDS text FULLTEXT ANALYZER prose BM25;
DEFINE INDEX IF NOT EXISTS node_front ON node FIELDS front;
DEFINE TABLE IF NOT EXISTS link TYPE RELATION IN node OUT node SCHEMALESS;
DEFINE TABLE IF NOT EXISTS episode SCHEMALESS;
DEFINE INDEX IF NOT EXISTS episode_text ON episode FIELDS text FULLTEXT ANALYZER prose BM25;
DEFINE TABLE IF NOT EXISTS turn SCHEMALESS;
DEFINE INDEX IF NOT EXISTS turn_episode ON turn FIELDS episode;
DEFINE INDEX IF NOT EXISTS turn_text ON turn FIELDS text FULLTEXT ANALYZER prose BM25;
DEFINE TABLE IF NOT EXISTS stretch SCHEMALESS;
DEFINE TABLE IF NOT EXISTS probe SCHEMALESS;
DEFINE TABLE IF NOT EXISTS lemma SCHEMALESS;
DEFINE TABLE IF NOT EXISTS proof SCHEMALESS;
DEFINE INDEX IF NOT EXISTS proof_text ON proof FIELDS text FULLTEXT ANALYZER prose BM25;
DEFINE TABLE IF NOT EXISTS agent SCHEMALESS;
DEFINE TABLE IF NOT EXISTS rules SCHEMALESS;
DEFINE TABLE IF NOT EXISTS reduction SCHEMALESS;
