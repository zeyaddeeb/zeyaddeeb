{
  "name": "zeyaddeeb",
  "version": "0.1.86",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "docker compose up -d && turbo dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "turbo run db:push --filter=@zeyaddeeb/db",
    "db:seed": "turbo run db:seed --filter=@zeyaddeeb/db",
    "lint": "biome lint",
    "format": "biome check --write --linter-enabled=false",
    "clean": "turbo clean",
    "check-types": "turbo check-types",
    "test": "turbo test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^14.0.0",
    "next": "16.3.6",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
