{
  "name": "zeyaddeeb",
  "version": "0.1.59",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "docker compose up -d && turbo dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "turbo run db:push --filter=@zeyaddeeb/db",
    "db:seed": "turbo run db:seed --filter=@zeyaddeeb/db",
    "lint": "biome lint",
    "format": "biome format --write",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
