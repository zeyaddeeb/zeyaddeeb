{
  "name": "@zeyaddeeb/www",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "clean": "git clean -xdf .next .turbo .cache node_modules",
    "generate:land": "node scripts/capacity-land.mjs && biome format --write features/capacity/land-data.ts",
    "generate:county": "node scripts/capacity-county.mjs && biome format --write features/capacity/county-data.ts",
    "generate:jazz": "node scripts/jazz-corpus.mjs && biome format --write features/jazz/corpus-data.ts",
    "generate:voyager": "node scripts/voyager-ephemeris.mjs && node scripts/voyager-source.mjs && biome format --write features/voyager/ephemeris-data.ts features/voyager/source-data.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@zeyaddeeb/ui": "workspace:*",
    "@zeyaddeeb/wasm": "workspace:*",
    "framer-motion": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "^0.186.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.186.0",
    "@zeyaddeeb/config": "workspace:*",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
