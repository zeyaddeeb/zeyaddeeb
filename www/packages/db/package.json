{
  "name": "@zeyaddeeb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./collection-options": "./src/collection-options.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
