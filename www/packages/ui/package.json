{
  "name": "@zeyaddeeb/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./crdt": "./src/crdt.ts",
    "./fonts": "./src/fonts.ts",
    "./json-ld": "./src/components/json-ld.tsx",
    "./pagination": "./src/components/pagination.tsx",
    "./postcss": "./postcss.config.js",
    "./seo": "./src/seo.ts",
    "./site": "./src/site.ts",
    "./site.css": "./src/site.css",
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "default": "./dist/index.css"
    }
  },
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "check-types": "tsc --noEmit",
    "lint": "biome lint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:",
    "@types/react": "catalog:",
    "@zeyaddeeb/config": "workspace:*",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "vitest": "catalog:"
  }
}
